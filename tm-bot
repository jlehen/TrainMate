#!/bin/bash
set -e

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Check if virtual environment exists
if [ ! -d "$SCRIPT_DIR/venv" ]; then
    echo "Initializing virtual environment..."
    python3 -m venv "$SCRIPT_DIR/venv"
    echo "Initialization complete! Install dependencies: venv/bin/pip install -r requirements.txt"
fi

# Run the Telegram bot front-end with the passed arguments
exec "$SCRIPT_DIR/venv/bin/python" "$SCRIPT_DIR/trainmate_bot.py" "$@"
